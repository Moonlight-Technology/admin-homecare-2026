PORT=4000
NODE_ENV=development

DATABASE_URL=postgresql://nakes:nakes@localhost:5432/nakes?schema=public
# Direct (non-pooled) connection for `prisma migrate` and the seed. Behind a transaction pooler (PgBouncer, Neon
# `-pooler` hosts) migrations can leave their advisory lock stuck. Without a pooler, use the same value as DATABASE_URL.
DIRECT_DATABASE_URL=postgresql://nakes:nakes@localhost:5432/nakes?schema=public

# Origin of the admin web; the only origin allowed to call the API with credentials.
WEB_ORIGIN=http://localhost:3000

# Short-lived access token, kept in browser memory only.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900

# Refresh token, sent as an HTTP-only cookie scoped to /api/v1/auth.
REFRESH_TOKEN_TTL_DAYS=14
COOKIE_SECURE=false

# Password reset link base; the token is appended as ?token=...
PASSWORD_RESET_URL=http://localhost:3000/reset-password
PASSWORD_RESET_TTL_MINUTES=30

# Used only by `pnpm prisma:seed` to create the first platform super admin.
SEED_SUPER_ADMIN_EMAIL=admin@nakes.local
SEED_SUPER_ADMIN_PASSWORD=

# Private document storage (spec §10): local | s3 | cloudinary. Whatever the driver, files are never public and are
# only served through the API's short-lived signed links. `local` is refused when NODE_ENV=production.
STORAGE_DRIVER=local
# local: unencrypted files on this machine's disk (development only).
STORAGE_DIR=./storage

# s3: AWS S3, Cloudflare R2, or MinIO. Keep the bucket private (block public access, no public bucket URL).
#   AWS:   S3_REGION=ap-southeast-3 (Jakarta), S3_ENDPOINT empty, S3_SERVER_SIDE_ENCRYPTION=AES256
#   R2:    S3_REGION=auto, S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
#   MinIO: S3_REGION=us-east-1, S3_ENDPOINT=http://localhost:9000, S3_FORCE_PATH_STYLE=true (see docker-compose.yml)
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=
S3_SERVER_SIDE_ENCRYPTION=

# cloudinary: files are stored as private `raw` assets of type `authenticated` (no public URL, no transformations).
# Cloudinary keeps data outside Indonesia; prefer S3 (Jakarta) or R2 for production documents.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=nakes
# Signs short-lived document upload/download links; at least 32 characters, different from JWT_ACCESS_SECRET.
STORAGE_SIGNING_SECRET=change-me-to-another-long-random-string
DOCUMENT_URL_TTL_SECONDS=300
# Public base URL of this API, used to build signed document links.
API_PUBLIC_URL=http://localhost:4000/api/v1

# Encrypts practitioner credential numbers (STR/SIP) and keys their duplicate check; at least 32 characters,
# different from the other secrets. Changing it makes stored numbers unreadable.
CREDENTIAL_ENCRYPTION_KEY=change-me-to-a-third-long-random-string

# Machine key for POST /bookings, sent by the customer app's backend as `Authorization: Bearer <key>`.
# At least 32 characters; leave empty to keep bookings disabled.
BOOKINGS_API_KEY=

# Invitation links for owners of clinics created by a platform admin.
INVITATION_URL=http://localhost:3000/accept-invitation
INVITATION_TTL_HOURS=72
