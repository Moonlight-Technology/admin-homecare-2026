# Merge these settings into apps/api/.env or your production API environment.
# Do not replace the whole API env file: preserve DB URLs, encryption key and auth secrets.
STORAGE_DRIVER=minio
S3_BUCKET=nakes-documents
S3_ENDPOINT=http://127.0.0.1:9000
# For an API container attached to network nakes-storage, use http://minio:9000 instead.
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=nakes-documents-api
# Must equal MINIO_APP_PASSWORD, never MINIO_ROOT_PASSWORD.
S3_SECRET_ACCESS_KEY=replace-with-the-app-password-from-minio-env
# Empty preserves existing DocumentsService object keys. Keep this stable after cutover.
S3_PREFIX=
# Leave empty unless a real MinIO KMS has been installed and tested.
S3_SERVER_SIDE_ENCRYPTION=
DOCUMENT_URL_TTL_SECONDS=300

# Other required production settings (adapt public hosts to your deployment):
NODE_ENV=production
COOKIE_SECURE=true
WEB_ORIGIN=https://admin.example.com
API_PUBLIC_URL=https://api.example.com/api/v1
