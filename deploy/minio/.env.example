# Copy to .env on the Linux server; chmod 600 .env. Do not commit real credentials.
MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
MC_VERSION=RELEASE.2025-08-13T08-35-41Z

MINIO_ROOT_USER=nakes-storage-admin
MINIO_ROOT_PASSWORD=replace-with-random-root-password
MINIO_APP_USER=nakes-documents-api
MINIO_APP_PASSWORD=replace-with-a-different-random-app-password
MINIO_BUCKET=nakes-documents

# Existing dedicated disk/mount; prepare this directory with UID/GID 10001 before starting.
MINIO_DATA_DIR=/srv/nakes/minio/data
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Console is only accessed over an SSH tunnel. Keep ports aligned if you change them.
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
